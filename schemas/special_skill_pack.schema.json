{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schema_version","id","reference_size","assets","variants"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "layout_version":{"enum":["2.0"]},
    "student_slug":{"type":"string","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},
    "id":{"type":"string","minLength":1},
    "revision":{"type":"integer","minimum":1},
    "content_id":{"type":"integer","minimum":1},
    "actor_aliases":{"type":"array","items":{"type":"string","minLength":1}},
    "reference_size":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":1}},
    "assets":{"type":"array","items":{
      "type":"object","required":["group","tag","image","sha256"],
      "properties":{
        "group":{"enum":["banners","portraits","tooltips","cards","copy_cards"]},
        "tag":{"type":"string","minLength":1},
        "image":{"type":"string","minLength":1},
        "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "card_identity_suffix":{"type":"string"},
        "reference_only":{"type":"boolean"}
        ,"asset_key":{"type":"string","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"}
        ,"expected_size":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":1}}
      }
    }},
    "variants":{"type":"array","items":{
      "type":"object","required":["id","phase","banner_tags","cost_kind","requires_cost_drop"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "phase":{"type":"string","minLength":1},
        "banner_tags":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "cost_kind":{"enum":["zero","positive","any"]},
        "requires_cost_drop":{"type":"boolean"},
        "requires_selected_actor":{"type":"boolean"},
        "card_rotation":{"enum":["optional","required"]},
        "required_visual_fields":{"type":"object"}
        ,"required_context_tag":{"type":"string","minLength":1}
      }
    }}
  }
}
